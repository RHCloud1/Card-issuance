APP_NAME=Card Issuance
APP_SECRET=change-this-to-a-long-random-string
APP_BASE_URL=http://localhost:8080
DATABASE_PATH=/data/card_issuance.sqlite3
ADMIN_PATH=/change-this-admin-path
ADMIN_USERNAME=admin@example.com
ADMIN_PASSWORD=change-this-admin-password
ORDER_EXPIRE_MINUTES=15
ENABLE_MOCK_PAYMENTS=0
# USDT 入账后台扫描间隔（秒），0 为关闭
CRYPTO_WATCH_INTERVAL=30
# 后台登录：同一 IP 在 LOGIN_LOCK_MINUTES 分钟内失败 LOGIN_MAX_FAILURES 次后锁定
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_MINUTES=15
# 前面有几层可信反向代理：内置 Caddy / 宝塔 Nginx 反代填 1；端口直接对外暴露时必须为 0
TRUSTED_PROXY_COUNT=0
# 防止未付款订单占光库存：同一邮箱 / 同一 IP 同时待付款的订单数上限，同一 IP 每小时下单上限
ORDER_MAX_PENDING_PER_CONTACT=2
ORDER_MAX_PENDING_PER_IP=3
ORDER_CREATE_LIMIT_PER_HOUR=10
# 查单 / 取卡密码：同一 IP 或同一邮箱 15 分钟内失败次数上限
QUERY_MAX_FAILURES=8
# 同一 IP 待支付订单合计最多预占的卡密数；同一 IP 每小时售后工单上限
ORDER_MAX_PENDING_CARDS_PER_IP=10
TICKET_LIMIT_PER_HOUR=5
